# Copy to .env or export before aulos-knowledge

# Dev (default)
# AULOS_KNOWLEDGE_DB_URL=sqlite:///./data/knowledge.db

# Production / S1 Postgres (compose maps 5433→5432)
# AULOS_KNOWLEDGE_DB_URL=postgresql+psycopg://aulos:aulos@127.0.0.1:5433/aulos_knowledge

# AULOS_KNOWLEDGE_ARTIFACT_ROOT=./data/persist/artifacts
# AULOS_KNOWLEDGE_SYNC_JOBS=true
# AULOS_KNOWLEDGE_CATALOG_ROOT=
# REDIS_URL=redis://127.0.0.1:6379/0
