[Unit]
Description=aulos knowledge plane (:5095)
After=network-online.target docker.service
PartOf=aulos-host.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/hackathon/aulos/aulos-knowledge
Environment=AULOS_KNOWLEDGE_HOST=127.0.0.1
Environment=AULOS_KNOWLEDGE_PORT=5095
Environment=AULOS_KNOWLEDGE_DB_URL=postgresql+psycopg://aulos:aulos@127.0.0.1:5433/aulos_knowledge
Environment=AULOS_KNOWLEDGE_ARTIFACT_ROOT=/home/ubuntu/hackathon/aulos/aulos-knowledge/data/persist/artifacts
Environment=AULOS_KNOWLEDGE_SYNC_JOBS=false
Environment=AULOS_KNOWLEDGE_CATALOG_ROOT=/home/ubuntu/hackathon/aulos/aulos-skills/skills/aulos-listening-corpus/assets/catalog
EnvironmentFile=-/home/ubuntu/hackathon/aulos/.run/host.env
ExecStart=/home/ubuntu/hackathon/aulos/aulos-knowledge/.venv/bin/aulos-knowledge
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=20
StandardOutput=append:/home/ubuntu/hackathon/aulos/.run/knowledge.log
StandardError=append:/home/ubuntu/hackathon/aulos/.run/knowledge.log

[Install]
WantedBy=default.target
Also=aulos-host.target
