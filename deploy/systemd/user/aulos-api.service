[Unit]
Description=aulos API gateway (:5090)
After=network-online.target
PartOf=aulos-host.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/hackathon/aulos/aulos-api
Environment=AULOS_API_HOST=127.0.0.1
Environment=AULOS_API_PORT=5090
Environment=AULOS_API_FAKE_AGENT=true
Environment=AULOS_API_CORS_ORIGINS=https://aulos.purezen.ai,https://aulos-ops.purezen.ai,http://127.0.0.1:5091,http://127.0.0.1:5092
Environment=AULOS_DB_URL=postgresql+psycopg://aulos:aulos@127.0.0.1:5433/aulos
Environment=AULOS_DB_FAILOVER_URL=sqlite:////home/ubuntu/hackathon/aulos/aulos-api/data/aulos.db
Environment=AULOS_DB_ACTIVE_ROLE=primary
Environment=AULOS_DB_SYNC_ENABLED=true
Environment=AULOS_DB_SYNC_INTERVAL_SEC=300
Environment=AULOS_DB_AUTO_FAILOVER=true
Environment=AULOS_DB_AUTO_FAILBACK=false
Environment=AULOS_REDIS_URL=redis://127.0.0.1:6379/0
Environment=AULOS_KNOWLEDGE_BASE_URL=http://127.0.0.1:5095
Environment=AULOS_KNOWLEDGE_PLANE_ENABLED=true
Environment=AULOS_JWT_SECRET=aulos-dev-jwt-secret-change-me-32b
Environment=AULOS_MAIL_PROVIDER=auto
Environment=AULOS_WEB_BASE_URL=https://aulos.purezen.ai
Environment=AULOS_BOOTSTRAP_SUPERADMIN_EMAIL=admin@agileway.ai
Environment=AULOS_BOOTSTRAP_SUPERADMIN_PASSWORD=ChangeMeAdmin123!
EnvironmentFile=-/home/ubuntu/hackathon/aulos/.run/host.env
ExecStart=/home/ubuntu/hackathon/aulos/aulos-api/.venv/bin/aulos-api --host 127.0.0.1 --port 5090
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=15
StandardOutput=append:/home/ubuntu/hackathon/aulos/.run/api.log
StandardError=append:/home/ubuntu/hackathon/aulos/.run/api.log

[Install]
WantedBy=default.target
Also=aulos-host.target
