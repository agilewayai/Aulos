# Copy to ../.run/host.env and replace every REPLACE_WITH_* value.
#   cp deploy/host.env.example .run/host.env
#
# Required keys (see deploy/README.md):
#   AULOS_JWT_SECRET
#   AULOS_BOOTSTRAP_SUPERADMIN_EMAIL
#   AULOS_BOOTSTRAP_SUPERADMIN_PASSWORD
#   AULOS_KNOWLEDGE_ADMIN_TOKEN

AULOS_JWT_SECRET=REPLACE_WITH_YOUR_JWT_SECRET_MIN_32_CHARS
AULOS_BOOTSTRAP_SUPERADMIN_EMAIL=REPLACE_WITH_YOUR_ADMIN_EMAIL
AULOS_BOOTSTRAP_SUPERADMIN_PASSWORD=REPLACE_WITH_YOUR_STRONG_PASSWORD
AULOS_KNOWLEDGE_ADMIN_TOKEN=REPLACE_WITH_YOUR_KNOWLEDGE_PLANE_TOKEN

# --- Optional LLM providers (Ops LLM tab also works) ---
# DeepSeek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AULOS_DEEPSEEK_MODEL=deepseek-chat

# Grok (xAI) — paste key when ready; model/base already defaulted in Ops.
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# AULOS_GROK_MODEL=grok-3-mini
# Chat active provider (optional). Draft/review roles are separate:
# AULOS_LLM_PROVIDER=deepseek
# AULOS_LLM_DRAFT_PROVIDER=deepseek
# AULOS_LLM_REVIEW_PROVIDER=grok
