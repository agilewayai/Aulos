# LLM provider (openai | anthropic | deepseek | grok | fake)
AULOS_LLM_PROVIDER=fake
AULOS_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Optional LangSmith observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=aulos-agent
LANGSMITH_API_KEY=

# Agent defaults
AULOS_SYSTEM_PROMPT=You are Aulos, a helpful assistant. Use tools when they improve accuracy.
AULOS_RECURSION_LIMIT=25
